# Sentiqa — miljøvariabler (mal). Kopier til .env.local og fyll inn ekte verdier.
# .env.local committes ALDRI (ligger i .gitignore).

# --- Kontrollrom (R-G Invest) ---
# Sentiqa sender hendelser + heartbeat hit.
# KONTROLLROM_KEY = samme som KONTROLLROM_INGEST_KEY i kontrollrommet.
KONTROLLROM_URL=https://r-g-invest-as.vercel.app
KONTROLLROM_KEY=
KONTROLLROM_PRODUKT=sentiqa

# --- Supabase ---
# Finnes i Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ahsetswpwzvcizkurymg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (brukes av bakgrunnsarbeidere/admin-operasjoner). ALDRI eksponert i klient.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI-assistenten, §8) ---
# Hentes fra console.anthropic.com → API Keys. Server-only, aldri i klient.
ANTHROPIC_API_KEY=

# --- App ---
# Tving all tidsvisning til Europe/Oslo (PROSJEKT.md §18)
TZ=Europe/Oslo
